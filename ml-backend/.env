# FTM ML Backend Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ftm_database
DB_USER=root
DB_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5176

# Model Configuration
MODEL_PATH=models/anomaly_detector.pkl
CONTAMINATION=0.1

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/ml_backend.log

# Frontend API URL (for integration)
FRONTEND_API_URL=https://abhiftm.com/api