# Frontend Environment Configuration
# Copy this file to .env and fill in your actual values

# ML Backend Configuration
VITE_ML_API_URL=http://localhost:8000

# Existing API Configuration (if needed)
VITE_API_URL=https://abhiftm.com/api

# Must match the backend TRANSIT_KEY and TRANSIT_OUT_KEY values.
# If the backend omits TRANSIT_OUT_KEY, use the same value as TRANSIT_KEY.
# VITE_ values are bundled into browser code; they are not secret storage.
VITE_TRANSIT_KEY=
VITE_TRANSIT_OUT_KEY=
