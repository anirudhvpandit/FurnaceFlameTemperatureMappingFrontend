# Frontend Environment Configuration
# Copy this file to .env and fill in your actual values

# ML Backend Configuration
VITE_ML_API_URL=http://localhost:8000

# Existing API Configuration (if needed)
VITE_API_URL=hhttp://localhost:8000

# Must match the backend TRANSIT_KEY and TRANSIT_OUT_KEY values.
# If the backend does not configure TRANSIT_OUT_KEY, use the same value as TRANSIT_KEY.
# Generate keys with the backend's --generate-keys option; these VITE_ values are
# bundled into browser code, so they provide payload wrapping, not secret key storage.
VITE_TRANSIT_KEY=
VITE_TRANSIT_OUT_KEY=
